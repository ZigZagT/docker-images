#!/bin/bash
# chrome-launcher — run Chrome with sane defaults
# Wraps chrome-raw with viewport, rendering, and anti-detection flags.
# Extra args are appended (Chrome uses last value for duplicate flags).

VIEWPORT_WIDTH="${VIEWPORT_WIDTH:-1920}"
VIEWPORT_HEIGHT="${VIEWPORT_HEIGHT:-1080}"
CDP_PORT="${CDP_PORT:-18800}"

# Profile persistence: when CHROME_USER_DATA_DIR is set, Chrome stores its
# profile (cookies, history, logins, extensions, sessionStorage) at that
# path. Mount a host volume to persist across container restarts. When
# unset, Chrome uses an ephemeral /tmp/org.chromium.Chromium.scoped_dir.*
# that gets wiped on restart.
profile_flag=()
if [ -n "$CHROME_USER_DATA_DIR" ]; then
    mkdir -p "$CHROME_USER_DATA_DIR"
    profile_flag+=(--user-data-dir="$CHROME_USER_DATA_DIR")
    echo "chrome-launcher: persisting profile at $CHROME_USER_DATA_DIR" >&2
    # Clear stale Singleton{Lock,Socket,Cookie} symlinks. Chrome writes
    # these as `<hostname>-<pid>` to refuse a second chromium against the
    # same profile. Across container restarts the hostname changes
    # (default docker behaviour) and on a fresh container an unrelated
    # process may inherit the old PID, so chrome misreads the lock as
    # "another computer is using this profile" or "PID still alive" and
    # refuses to launch. We're the only chromium in this container by
    # design, so clearing the lock is safe.
    rm -f "$CHROME_USER_DATA_DIR/SingletonLock" \
          "$CHROME_USER_DATA_DIR/SingletonSocket" \
          "$CHROME_USER_DATA_DIR/SingletonCookie"
    # Suppress the "Restore Pages?" crash bubble: when we kill chrome
    # (SIGTERM during restart-browser, container shutdown, etc.) it marks
    # exit_type=Crashed, and on next boot Chrome prompts instead of
    # honouring the user's "Continue where you left off" setting. The
    # prompt requires a real click — there's no human-in-the-loop in
    # headless. Resetting exit_type to "Normal" makes Chrome auto-act on
    # whatever startup behaviour the user configured (NTP, restore, list
    # of pages — all respected). We DON'T touch session.restore_on_startup
    # so the user's chrome://settings choice is the source of truth.
    PREFS="$CHROME_USER_DATA_DIR/Default/Preferences"
    if [ -f "$PREFS" ]; then
        tmp=$(mktemp)
        if jq '.profile.exit_type = "Normal"
               | .profile.exited_cleanly = true' "$PREFS" > "$tmp" 2>/dev/null; then
            mv "$tmp" "$PREFS"
        else
            rm -f "$tmp"
        fi
    fi
fi

UA_FILE="/usr/local/etc/chrome-ua"
UA=""
if [ -f "$UA_FILE" ]; then
    UA=$(cat "$UA_FILE")
fi

filtered=()
for arg in "$@"; do
    case "$arg" in
        --disable-sync|--disable-background-networking|about:blank) ;;
        *) filtered+=("$arg") ;;
    esac
done

# GPU detection — Chrome's --headless mode auto-injects
# --use-angle=swiftshader-webgl which forces software WebGL even when a
# real GPU is present. We override with --use-angle=vulkan only when both:
#   (1) a render node (/dev/dri/renderD*) is accessible, AND
#   (2) at least one non-SwiftShader Vulkan ICD is installed.
# When both are true, Mesa+ICD can drive the GPU. Otherwise we leave the
# default flag in place — adding --use-angle=vulkan without a real adapter
# breaks WebGL on macOS (verified).
gpu_flags=()
if ls /dev/dri/renderD* > /dev/null 2>&1; then
    has_render_node=1
else
    has_render_node=0
fi
has_real_vulkan_icd=0
if [ -d /usr/share/vulkan/icd.d ]; then
    for icd in /usr/share/vulkan/icd.d/*.json; do
        case "$(basename "$icd")" in
            *swiftshader*|*lvp_icd*) ;;  # software-only ICDs, skip
            *) has_real_vulkan_icd=1 ;;
        esac
    done
fi
if [ "$has_render_node" = "1" ] && [ "$has_real_vulkan_icd" = "1" ]; then
    gpu_flags+=(--use-angle=vulkan)
    echo "chrome-launcher: GPU detected (render node + Vulkan ICD), enabling --use-angle=vulkan" >&2
else
    gpu_flags+=(--disable-gpu)
    echo "chrome-launcher: no GPU detected (render_node=$has_render_node, vulkan_icd=$has_real_vulkan_icd), using --disable-gpu software rendering" >&2
fi

exec chrome-raw \
    --headless \
    --no-sandbox \
    "${profile_flag[@]}" \
    --remote-debugging-port="$CDP_PORT" \
    --window-size="${VIEWPORT_WIDTH},${VIEWPORT_HEIGHT}" \
    --screen-info="{0,0 ${VIEWPORT_WIDTH}x${VIEWPORT_HEIGHT}}" \
    "${gpu_flags[@]}" \
    --disable-renderer-backgrounding \
    --disable-background-timer-throttling \
    --disable-backgrounding-occluded-windows \
    --font-render-hinting=none \
    --force-device-scale-factor=1 \
    --force-color-profile=srgb \
    ${UA:+--user-agent="$UA"} \
    "${filtered[@]}"
