ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG NODE_VERSION

RUN if [ -z "$NODE_VERSION" ]; then echo "NODE_VERSION not set" && exit 1; fi \
    && echo "Installing Node.js version $NODE_VERSION" \
    && apt-get update \
    && apt-get install -y ca-certificates curl gnupg \
    && mkdir -p /usr/share/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg \
    && chmod 644 /usr/share/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_VERSION.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y \
        nodejs \
        python3 \
        python3-setuptools \
    && apt-get purge -y gnupg \
    && apt-get autoremove -y --purge \
    # Remove nodesource apt source to prevent future `apt-get update` failures.
    # deb.nodesource.com intermittently serves mismatched package metadata during
    # mirror syncs, causing errors like "File has unexpected size ... Mirror sync
    # in progress?" and long timeouts.
    && rm -f /etc/apt/sources.list.d/nodesource.list
